# syntax=docker/dockerfile:1
# ==============================================================
# NOMAD Jetson adapter image — Isaac ROS base + generic C++ ROS adapter.
#
# The camera, VIO estimator, mapping, and obstacle-avoidance stacks are not part
# of the current baseline. A future estimator can publish the generic VIO
# contract consumed by nomad_vehicle_node without changing this image's core.
# ==============================================================

ARG BASE_IMAGE=isaac_ros_dev-aarch64
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
LABEL maintainer="The NOMAD Authors"
LABEL description="NOMAD generic ROS adapter node for Jetson"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    ros-humble-rclcpp \
    ros-humble-std-srvs \
    ros-humble-ament-cmake \
    ros-humble-geometry-msgs \
    ros-humble-nav-msgs \
    ros-humble-sensor-msgs \
    ros-humble-std-msgs \
    ros-humble-tf2-ros \
    build-essential \
    cmake \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir pymavlink transforms3d 'numpy<2'

COPY CMakeLists.txt /ws/src/nomad/CMakeLists.txt
COPY include/ /ws/src/nomad/include/
COPY src/ /ws/src/nomad/src/
COPY scripts/dev/generate_mavlink.py /ws/src/nomad/scripts/dev/generate_mavlink.py
COPY third_party/ardupilot-mavlink/ /ws/src/nomad/third_party/ardupilot-mavlink/
COPY ros2/nomad_ros/ /ws/src/nomad/ros2/nomad_ros/
# Retained ground-side video tools are imported as python.tools inside the
# container by the optional video bridge service.
COPY python/__init__.py /opt/nomad/python/__init__.py
COPY python/tools/ /opt/nomad/python/tools/

SHELL ["/bin/bash", "-c"]
RUN . /opt/ros/humble/setup.bash && cd /ws/src/nomad/ros2/nomad_ros && \
    colcon build --packages-select nomad_ros \
      --build-base /ws/build --install-base /ws/install \
      --event-handlers console_cohesion+
SHELL ["/bin/sh", "-c"]

ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV ROS_LOCALHOST_ONLY=0
ENV PYTHONPATH="/opt/nomad"

COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

WORKDIR /ws
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["ros2", "run", "nomad_ros", "nomad_vehicle_node", "--ros-args", "-p", "endpoint:=udpin:0.0.0.0:14552"]
