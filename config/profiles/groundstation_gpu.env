# =============================================================================
# NOMAD Configuration Profile: GROUND STATION GPU (Local workstation GPU)
# =============================================================================
#
# Load with:  python scripts/profile.py load groundstation_gpu
# Verify:     python scripts/profile.py show
#
# GPU-capable ground-station workstation runs the optional ROS 2, VIO, camera,
# and perception workloads locally. Supported companion replacement, not a
# second vehicle-control authority.
# =============================================================================

# ---------------------------------------------------------------------------
# Profile identity & separation of concerns
# ---------------------------------------------------------------------------
NOMAD_PROFILE=groundstation_gpu
NOMAD_PROFILE_DESCRIPTION="Ground station GPU: Workstation runs ROS 2, VIO, camera, and perception locally"
NOMAD_COMPUTE_PLACEMENT=groundstation
NOMAD_HAS_COMPANION=false
NOMAD_HAS_PERCEPTION=true

# ---------------------------------------------------------------------------
# Service autostart — ground station side
# ---------------------------------------------------------------------------
NOMAD_AUTOSTART_EDGE_CORE=false
NOMAD_AUTOSTART_MAVLINK_ROUTER=true
NOMAD_AUTOSTART_MEDIAMTX=true
NOMAD_AUTOSTART_ROS_VEHICLE=true
NOMAD_AUTOSTART_VIDEO_BRIDGE=true
NOMAD_AUTOSTART_HEALTH_MONITOR=true
NOMAD_AUTOSTART_TIME_SYNC=true

# ---------------------------------------------------------------------------
# MAVLink and Video endpoints (ground station side)
# ---------------------------------------------------------------------------
NOMAD_CORE_SITL_PORT=14570
NOMAD_LTE_UDP_PORT=14550
NOMAD_ELRS_SERIAL=/dev/ttyUSB0
NOMAD_ELRS_BAUD=115200
NOMAD_VIDEO_RTSP_URL=rtsp://127.0.0.1:8554/stream
NOMAD_VIDEO_RTSP_PORT=8554

# ---------------------------------------------------------------------------
# Auth (shared with the core CLI; SR-SEC-02/03)
# ---------------------------------------------------------------------------
NOMAD_API_KEY=nomad-dev-sitl-key
NOMAD_ALLOW_INSECURE_REMOTE=false
NOMAD_SIM_MODE=false

# ---------------------------------------------------------------------------
# VIO & Safety
# ---------------------------------------------------------------------------
NOMAD_VIO_SOURCE_REQUIRED=true
NOMAD_FENCE_POLYGON=
NOMAD_FENCE_MARGIN_M=2.0

# Reviewed C++ velocity envelope. Malformed values fail closed.
NOMAD_VELOCITY_MAX_XY=2.0
NOMAD_VELOCITY_MAX_Z=1.0
NOMAD_VELOCITY_MAX_YAW_RATE=1.0
