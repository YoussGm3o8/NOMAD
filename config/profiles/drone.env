# =============================================================================
# NOMAD Configuration Profile: REAL DRONE (Jetson + ArduPilot FC)
# =============================================================================
#
# Load with:  nomad profile load drone
# Verify:     nomad profile show
#
# This is the production profile for the NVIDIA Jetson Orin Nano with a
# physical flight controller. Perception is deliberately disabled until a
# real VIO/obstacle-avoidance integration exists. This runs ON the companion
# computer, not on a dev workstation.
#
# IMPORTANT: Before first use, you MUST:
#   1. Replace USER with the Jetson's login user in all paths
#   2. Generate and set NOMAD_API_KEY and NOMAD_INTERNAL_TOKEN
#   3. Set GCS_IP or ensure Tailscale auto-discovery works
#   4. Run scripts/setup/provision_isaac_ros.sh to build the Isaac ROS image
#   5. Run infra/systemd/install.sh to install systemd units
#
# Quick start:
#   nomad profile load drone
#   # Edit paths and tokens:
#   nano config/nomad.env
#   # Provision and deploy:
#   nomad start all
# =============================================================================

# ---------------------------------------------------------------------------
# Profile identity
# ---------------------------------------------------------------------------
NOMAD_PROFILE=drone
NOMAD_PROFILE_DESCRIPTION="Real drone: Jetson Orin Nano + ArduPilot FC; perception opt-in"

# ---------------------------------------------------------------------------
# Service Autostart — all hardware services
# ---------------------------------------------------------------------------
NOMAD_AUTOSTART_EDGE_CORE=true
NOMAD_AUTOSTART_MAVLINK_ROUTER=true
NOMAD_AUTOSTART_MEDIAMTX=false
NOMAD_AUTOSTART_ISAAC_ROS_CONTAINER=false
NOMAD_AUTOSTART_ROS_HTTP_BRIDGE=false
NOMAD_AUTOSTART_ROS_VEHICLE=false
NOMAD_AUTOSTART_VIDEO_BRIDGE=false
NOMAD_AUTOSTART_HEALTH_MONITOR=true
NOMAD_AUTOSTART_TIME_SYNC=true

# ---------------------------------------------------------------------------
# Paths — Jetson Orin Nano filesystem (REPLACE USER)
# ---------------------------------------------------------------------------
NOMAD_REPO_ROOT=/home/USER/NOMAD
NOMAD_LOG_DIR=/home/USER/nomad_logs
NOMAD_RUN_DIR=/run/nomad
NOMAD_DATA_DIR=/home/USER/NOMAD/data
NOMAD_MISSION_LOG_DIR=/home/USER/NOMAD/data/mission_logs
NOMAD_VENV=/home/USER/NOMAD/venv

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
NOMAD_API_HOST=0.0.0.0
NOMAD_API_PORT=8000
NOMAD_API_URL=http://localhost:8000
NOMAD_DOCKER_HOST_IP=172.17.0.1

# Tailscale / GCS — leave GCS_IP blank to discover via `tailscale status`
GCS_IP=
GCS_EXTRA_IPS=
GCS_PORT_LTE=14560
GCS_PORT_LOCAL=14550

# ---------------------------------------------------------------------------
# Auth — MUST set real keys before deployment
# ---------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Set the same NOMAD_API_KEY in the Mission Planner plugin config.
NOMAD_API_KEY=
NOMAD_INTERNAL_TOKEN=
NOMAD_ALLOW_INSECURE_REMOTE=false
NOMAD_ENABLE_TERMINAL_EXEC=false
NOVNC_VNC_PASSWORD=

# ---------------------------------------------------------------------------
# Sim mode — OFF for real hardware
# ---------------------------------------------------------------------------
NOMAD_SIM_MODE=false

# ---------------------------------------------------------------------------
# MAVLink — real flight controller on UART
# ---------------------------------------------------------------------------
MAVLINK_UART_DEV=/dev/ttyACM0
MAVLINK_UART_BAUD=921600
NOMAD_MAVLINK_ENDPOINT=127.0.0.1:14550
NOMAD_MAVLINK_DISCONNECT_TIMEOUT_S=3.0

# Reviewed C++ velocity envelope. Malformed values fail closed.
NOMAD_VELOCITY_MAX_XY=2.0
NOMAD_VELOCITY_MAX_Z=1.0
NOMAD_VELOCITY_MAX_YAW_RATE=1.0
NOMAD_BRIDGE_MAVLINK_ENDPOINT=127.0.0.1:14552

# ---------------------------------------------------------------------------
# Servo — physical servos via flight controller MAVLink
# ---------------------------------------------------------------------------
NOMAD_ENABLE_SERVOS=true

# ---------------------------------------------------------------------------
# MediaMTX — RTSP server on the Jetson
# ---------------------------------------------------------------------------
RTSP_PORT=8554
MEDIAMTX_CONFIG=/home/USER/NOMAD/infra/mediamtx.yml
MEDIAMTX_BIN=/home/USER/bin/mediamtx

# ---------------------------------------------------------------------------
# Isaac ROS Container — real Jetson container
# ---------------------------------------------------------------------------
ISAAC_CONTAINER_NAME=nomad_isaac_ros
ISAAC_IMAGE_NAME=nomad-isaac-ros:latest
ISAAC_IMAGE_FALLBACK=isaac_ros_dev-aarch64
ISAAC_WORKSPACE=/home/USER/workspaces/isaac_ros-dev
ISAAC_ROS_DOMAIN_ID=0

# Perception is intentionally unconfigured. Select a real estimator only after
# its ROS topics and ArduPilot integration have been verified.
NOMAD_ROS_VIO_SOURCE=
NOMAD_ROS_VIO_SOURCE_TOPIC=/nomad/vio_source

# ---------------------------------------------------------------------------
# ROS 2 adapter baseline (inactive until a real estimator is selected)
# ---------------------------------------------------------------------------
NOMAD_ROS_ROOT=/opt/ros/humble
NOMAD_ISAAC_WORKSPACE=/workspaces/isaac_ros-dev
NOMAD_VIO_MAX_AGE_S=1.0

# ---------------------------------------------------------------------------
# Video Bridge
# ---------------------------------------------------------------------------
VIDEO_BRIDGE_STREAM_PATH=stream
VIDEO_BRIDGE_WIDTH=640
VIDEO_BRIDGE_HEIGHT=360
VIDEO_BRIDGE_FPS=15
VIDEO_BRIDGE_BITRATE=800
VIDEO_RELAY_HTTP_HOST=localhost
VIDEO_RELAY_HTTP_PORT=9200
NOMAD_VIDEO_EXTERNAL_BRIDGE=false
NOMAD_DETECTIONS_AUTO_START=false
NOMAD_DETECTOR_INTERVAL_S=0.1
NOMAD_DETECTOR_MAX_WIDTH=960

# Optional mapping/camera modules stay disabled until a verified perception
# adapter exists. They are outside the current vehicle-control baseline.

# ---------------------------------------------------------------------------
# Google Drive Upload (optional)
# ---------------------------------------------------------------------------
GDRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
PYTHONUNBUFFERED=1
NOMAD_HEALTH_BROADCAST_INTERVAL_S=2.0

# ---------------------------------------------------------------------------
# Video topics
# ---------------------------------------------------------------------------
NOMAD_DEFAULT_VIDEO_TOPIC=/nomad/camera/image
NOMAD_RTSP_URL=
